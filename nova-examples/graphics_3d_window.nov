// Opens a high-level 3D graphics window and creates a colored cube object.
// Builds model, view, and perspective transforms, then rotates the cube.
// Draws frames until the window receives a close event, then releases resources.
#include <user/lib/gfx.nov>

#define DEMO_FOV 1.0471976

int main(int argc, char** argv) {
    GfxWindow window;
    GfxWindowOptions options;
    GfxEvent event;
    GfxObject cube;
    GfxTransform transform;
    float model[16];
    float view[16];
    float projection[16];
    float angle;
    int running;

    gfxInit3DWindowOptions(&options, 360, 260);
    gfxWindowOptionsSetTitle(&options, "Nova 3D API");
    if (gfxOpen3DWindow(&window, &options) == 0) {
        print("Could not open a 3D window");
        println();
        return 1;
    }

    gfxCubeInit(&cube);
    gfxCubeSetColor(&cube, makeRgba(230, 90, 72, 255));
    if (gfxCubeCreate(&cube, &window) == 0) {
        print("Could not create the 3D object");
        println();
        gfxClose3DWindow(&window);
        return 1;
    }

    gfxInitTransform(&transform, model, view, projection);
    gfxTransformSetCameraZ(&transform, -4.0);
    gfxTransformSetPerspective(&transform, &window, DEMO_FOV);
    angle = 0.0;
    running = 1;

    while (running != 0) {
        gfxTransformSetRotationXY(&transform, angle * 0.7, angle);
        if (gfxWindowClear(&window, makeRgba(12, 18, 30, 255)) == 0 ||
            gfxWindowDraw(&window, &cube, &transform) == 0 ||
            gfxWindowDisplay(&window) != 0) {
            running = 0;
        }

        if (gfxWindowPollEvent(&window, &event) != 0 &&
            event.type == GFX_EVENT_CLOSE) {
            running = 0;
        }
        angle = angle + 0.025;
        if (angle > 6.2831853) {
            angle = 0.0;
        }
        sleep(16);
    }

    gfxObjectDestroy(&cube, &window);
    gfxClose3DWindow(&window);
    return 0;
}
